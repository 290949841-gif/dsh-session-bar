{
  "name": "dsh-session-bar",
  "version": "0.1.0",
  "description": "DeepSeek Harness 侧栏会话状态条：任务进行中显示估算进度百分比和流光进度条，任务完成后整行转橙并一直保留到你点开为止。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "session",
    "sidebar",
    "progress",
    "status",
    "ui"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
